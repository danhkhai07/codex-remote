# Copy to `.env` and edit. Never commit the real `.env` (it is gitignored).

# ---------------------------------------------------------------------------
# Host-layout variables. Read by docker-compose to build bind mounts; the app
# does not see them. Each path must be ABSOLUTE and owned by the user the
# container runs as (CODEX_REMOTE_UID/GID below).
# ---------------------------------------------------------------------------

# Host path of your ~/.codex (Codex install, login, sessions, sqlite).
CODEX_HOME_HOST=/home/you/.codex

# A repository to expose as a Codex workspace. Mounted in the container at the
# SAME absolute path, so set this to the same value as (the first entry of)
# CODEX_REMOTE_WORKSPACE_ROOTS below.
CODEX_REMOTE_WORKSPACE_ROOT=/home/you/code/your-project

# UID/GID the gateway runs as inside the container. Must match the OWNER of the
# dirs above. 1000 is the image default (`node` user); use 0:0 on a root-only
# host or when your user is root.
CODEX_REMOTE_UID=1000
CODEX_REMOTE_GID=1000

# ---------------------------------------------------------------------------
# Application variables (read by the Node gateway).
# ---------------------------------------------------------------------------

# Public HTTPS origin used for Host and Origin validation.
CODEX_REMOTE_PUBLIC_ORIGIN=https://codex.example.com

# Generate separate high-entropy values. Never commit real values.
CODEX_REMOTE_PASSWORD=replace-with-a-long-password
CODEX_REMOTE_SESSION_SECRET=replace-with-at-least-32-random-characters

# Comma-separated absolute paths that users may select in the UI. Each must be
# bind-mounted into the container at its identical path (see docker-compose.yaml).
CODEX_REMOTE_WORKSPACE_ROOTS=/home/you/code/your-project

# Bind address the gateway listens on. The docker-compose service overrides this
# to 0.0.0.0 and publishes the port on 127.0.0.1 only.
CODEX_REMOTE_HOST=127.0.0.1
CODEX_REMOTE_PORT=5173
CODEX_REMOTE_SESSION_TTL_SECONDS=604800

# Path to the `codex` binary. `codex` (on PATH) is the local default; the
# docker-compose service overrides this with the host install's standalone
# binary under CODEX_HOME_HOST.
CODEX_REMOTE_CODEX_BIN=codex

# Optional timestamp-only screen presence ledger, in a writable directory.
CODEX_REMOTE_WORK_PRESENCE_FILE=

# Shared working-hours JSON database (optional; fixed server-side path).
CODEX_REMOTE_WORK_HOURS_FILE=

# Optional roots for file browsing/previews/downloads; defaults to workspace roots.
# Use / to browse the entire filesystem accessible to the gateway process.
# CODEX_REMOTE_FILE_ROOTS=/

# Shared read receipts; defaults to ~/.local/state/codex-remote/read-state.json.
# CODEX_REMOTE_READ_STATE_FILE=/persistent/state/read-state.json

# Shared context and conversation folders; defaults to ~/VAULTS/Codex-Context.
# Keep this directory on persistent storage and bind-mount it when using Docker.
# CODEX_REMOTE_CONTEXT_VAULT=/persistent/VAULTS/Codex-Context
